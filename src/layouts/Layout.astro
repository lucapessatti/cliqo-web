---
// Tipografías alojadas en la propia web (sin Google Fonts): no se envía la IP de nadie a terceros
// y se cargan con font-display: swap. Solo los pesos que se usan.
import "@fontsource/archivo-black/400.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "../styles/global.css";
import { SITE_URL } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cliqo · Datos, marketing y procesos para negocios locales",
  description =
    "Te decimos qué te está costando clientes, con datos. Análisis de datos, marketing digital y mejora de procesos para negocios locales: revisamos tu ficha de Google, tus redes y tus números.",
} = Astro.props;

const ruta = Astro.url.pathname.replace(/\/?$/, "/");
const canonical = new URL(ruta, SITE_URL).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#351e28" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cliqo" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="bg-aubergine font-texto text-crema antialiased">
    <slot />

    <script>
      // Historia de movimiento: añade `.in` a cada elemento al entrar en pantalla (una sola vez).
      const root = document.documentElement;
      root.classList.add("reveal-ready");
      const targets = document.querySelectorAll("[data-reveal],[data-section],[data-story]");
      if (!("IntersectionObserver" in window)) {
        targets.forEach((t) => t.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -6% 0px" },
        );
        targets.forEach((t) => io.observe(t));
      }
    </script>
  </body>
</html>
