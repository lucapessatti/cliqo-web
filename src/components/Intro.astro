---
// Intro de carga: fondo berenjena, la diana se compone en espiral (se dibuja
// del centro hacia afuera y se asienta), y "CLIQO" aparece poco a poco.
// Al terminar, el overlay se desvanece y revela la página.
// Respeta prefers-reduced-motion y se puede saltar con un clic.

// Espiral de Arquímedes, del centro hacia afuera (pathLength normalizado a 1).
const cx = 50, cy = 50, turns = 3.5, rMin = 1.5, rMax = 40, steps = 260;
let spiral = "";
for (let i = 0; i <= steps; i++) {
  const t = i / steps;
  const theta = t * turns * 2 * Math.PI;
  const r = rMin + t * (rMax - rMin);
  const x = (cx + r * Math.cos(theta)).toFixed(2);
  const y = (cy + r * Math.sin(theta)).toFixed(2);
  spiral += i === 0 ? `M${x} ${y}` : ` L${x} ${y}`;
}
---

<div id="intro" class="intro" role="presentation">
  <div class="intro-stack">
    <svg class="intro-svg" viewBox="0 0 100 100" fill="none" aria-hidden="true">
      <path class="spiral" d={spiral} pathLength="1" stroke="#78ab6b" stroke-width="1.8" stroke-linecap="round" />
      <g class="diana">
        <circle cx="50" cy="50" r="42" fill="none" stroke="#fffdb4" stroke-width="12" />
        <circle cx="50" cy="50" r="22" fill="none" stroke="#fffdb4" stroke-width="12" />
        <circle cx="50" cy="50" r="7" fill="#fffdb4" />
      </g>
    </svg>
    <span class="intro-word titulo">CLIQO</span>
  </div>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #351e28;
    transition: opacity 0.6s ease;
  }
  .intro.done {
    opacity: 0;
    pointer-events: none;
  }
  .intro-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .intro-svg {
    width: clamp(110px, 28vw, 180px);
    height: auto;
  }

  .spiral {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation:
      intro-draw 1.3s ease-out forwards,
      intro-spiral-fade 0.5s ease 1.25s forwards;
  }
  @keyframes intro-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes intro-spiral-fade {
    to { opacity: 0; }
  }

  .diana {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(-200deg) scale(0.25);
    animation: intro-pop 0.75s cubic-bezier(0.18, 1.1, 0.3, 1) 1.1s forwards;
  }
  @keyframes intro-pop {
    to { opacity: 1; transform: rotate(0deg) scale(1); }
  }

  .intro-word {
    color: #fffdb4;
    font-size: clamp(1.6rem, 6vw, 2.75rem);
    opacity: 0;
    filter: blur(8px);
    letter-spacing: 0.4em;
    padding-left: 0.4em;
    animation: intro-word 0.8s ease 1.75s forwards;
  }
  @keyframes intro-word {
    to { opacity: 1; filter: blur(0); letter-spacing: 0.08em; padding-left: 0.08em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spiral, .diana, .intro-word { animation: none; }
    .diana { opacity: 1; transform: none; }
    .intro-word { opacity: 1; filter: none; letter-spacing: 0.08em; padding-left: 0.08em; }
    .spiral { opacity: 0; }
  }
</style>

<script>
  const intro = document.getElementById("intro");
  if (intro) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.body.style.overflow = "hidden";
    const finish = () => {
      intro.classList.add("done");
      document.body.style.overflow = "";
      setTimeout(() => intro.remove(), 650);
    };
    if (reduce) {
      setTimeout(finish, 600);
    } else {
      const t = setTimeout(finish, 2750);
      intro.addEventListener("click", () => {
        clearTimeout(t);
        finish();
      });
    }
  }
</script>
