---
// Logotipo: la palabra CLIQO en Archivo Black con un asterisco pequeño en
// superíndice a la derecha. Sobre fondo oscuro las letras van en crema y el
// asterisco en verde; sobre crema, letras aubergine y asterisco verde oscuro.
interface Props {
  tono?: "crema" | "aubergine";
  clase?: string; // tamaño, p.ej. "text-2xl"
}
const { tono = "crema", clase = "text-2xl" } = Astro.props;
const letras = tono === "crema" ? "text-crema" : "text-aubergine";
const asterisco = tono === "crema" ? "text-verde" : "text-verde-oscuro";
---

<span class={`titulo relative inline-block ${clase} ${letras}`} aria-label="Cliqo">
  CLIQO<span class={`absolute -top-[0.38em] -right-[0.5em] text-[0.5em] ${asterisco}`} aria-hidden="true">*</span>
</span>
