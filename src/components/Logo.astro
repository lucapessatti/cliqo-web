---
// Logotipo: la diana (símbolo) + la palabra CLIQO en Archivo Black.
// Sobre fondo oscuro, letras crema y diana verde; sobre crema, letras
// aubergine y diana verde oscuro.
import Diana from "./Diana.astro";

interface Props {
  tono?: "crema" | "aubergine";
  clase?: string; // tamaño, p.ej. "text-2xl"
}
const { tono = "crema", clase = "text-2xl" } = Astro.props;
const letras = tono === "crema" ? "text-crema" : "text-aubergine";
const diana = tono === "crema" ? "text-verde" : "text-verde-oscuro";
---

<span class={`inline-flex items-center gap-[0.35em] ${clase}`} aria-label="Cliqo">
  <Diana clase={`${diana} h-[0.92em] w-[0.92em] shrink-0`} />
  <span class={`titulo ${letras}`}>CLIQO</span>
</span>
