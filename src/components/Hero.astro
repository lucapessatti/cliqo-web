---
// Hero tipográfico: tres palabras gigantes (Datos, Marketing, Procesos) con un
// subtítulo pequeño al lado de cada una, la diana de la marca como letra «O», un
// cursor suave tras «Marketing», patrón de puntos de fondo y una pestaña vertical
// de contacto. Debajo, el titular con la promesa y el mapa con el botón.
// Inspirado en una composición tipográfica de referencia, con las tipografías,
// colores y el acabado mate de Cliqo (sin degradados, brillos ni sombras).
import { CTA_URL, INSTAGRAM_URL } from "../config";
import LocationMap from "./LocationMap.astro";
import FlowButton from "./FlowButton.astro";
import Diana from "./Diana.astro";
---

<section id="inicio" class="relative overflow-hidden bg-aubergine text-crema">
  <!-- Patrón de puntos plano (SVG, sin degradados) -->
  <svg class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
    <defs>
      <pattern id="hero-dots" width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="1.4" cy="1.4" r="1.4" fill="#fffdb4" fill-opacity="0.14"></circle>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-dots)"></rect>
  </svg>

  <!-- Pestaña vertical de contacto (solo escritorio; en móvil hay botón fijo abajo) -->
  <a href={CTA_URL} class="hero-tab titulo">Diagnóstico gratis</a>

  <div class="relative mx-auto max-w-6xl px-5 pb-20 pt-8 sm:px-8 sm:pb-16 sm:pt-8">
    <span class="sr-only">Datos, marketing y procesos para negocios locales.</span>

    <!-- Pila de palabras: decorativa (el texto equivalente está arriba y en la sección «Tres líneas») -->
    <div class="stack" aria-hidden="true">
      <div class="stack-row hero-in" style="--d: 0ms">
        <p class="stack-cap stack-cap-left">Análisis de datos: qué se vende, cuándo y a quién.</p>
        <span class="titulo stack-word">DATOS</span>
      </div>

      <div class="stack-row hero-in" style="--d: 100ms">
        <span class="titulo stack-word">MARKETING</span>
        <svg class="stack-cursor" viewBox="-4 -4 40 56">
          <path d="M0 0 L0 38 L9.5 29.5 L16 44 L22.5 41 L16 26.5 L28 26.5 Z"></path>
        </svg>
        <p class="stack-cap">Ficha de Google, redes y contenido con buena imagen.</p>
      </div>

      <div class="stack-row hero-in" style="--d: 200ms">
        <span class="titulo stack-word">PR<Diana clase="stack-o" />CESOS</span>
        <p class="stack-cap">Menos tareas repetitivas: recordatorios, respuestas e informes.</p>
      </div>
    </div>

    <!-- Promesa: separador, etiqueta y titular (H1) -->
    <div class="hero-in mt-8 items-center gap-5 md:flex" style="--d: 300ms">
      <span class="hidden h-px flex-1 bg-crema/25 md:block"></span>
      <span class="mb-3 block whitespace-nowrap text-xs font-semibold tracking-[0.18em] text-crema/70 md:mb-0 md:text-sm">
        PARA NEGOCIOS LOCALES
      </span>
      <h1 class="titulo max-w-xl text-balance text-2xl text-crema md:text-[1.9rem]">
        Te decimos qué te está costando clientes. <span class="text-verde">Con datos.</span>
      </h1>
    </div>

    <!-- Fila inferior: mapa y acción -->
    <div class="mt-8 flex flex-col items-start gap-8 md:flex-row md:items-end md:gap-10">
      <div class="hero-map hero-in order-2 md:order-1" style="--d: 400ms">
        <LocationMap />
      </div>

      <div class="hero-in order-1 md:order-2" style="--d: 480ms">
        <p class="max-w-md text-lg leading-relaxed text-crema/85">
          Análisis de datos, marketing digital y mejora de procesos para negocios locales.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-4">
          <FlowButton id="cta-hero" href={CTA_URL} text="Pedir diagnóstico gratis" size="md" tone="oscuro" />
          <a
            href="#como-trabajamos"
            class="text-sm font-semibold text-verde underline-offset-4 hover:underline"
          >
            Cómo trabajamos ↓
          </a>
        </div>
      </div>
    </div>

    {
      INSTAGRAM_URL && (
        <a
          href={INSTAGRAM_URL}
          class="hero-ig"
          aria-label="Instagram de Cliqo"
          rel="noopener"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
      )
    }
  </div>
</section>

<style>
  /* Solo se oculta si hay JS (el script pone html.js); sin JS el hero se ve entero. */
  :global(html.js:not(.hero-go)) .hero-in {
    opacity: 0;
  }
  :global(html.hero-go) .hero-in {
    animation: hero-in var(--duration-enter) var(--ease-out) var(--d, 0ms) both;
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(12px); }
  }

  /* ---- Pila de palabras ---- */
  .stack {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .stack-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }
  .stack-word {
    display: inline-block;
    font-size: clamp(2.4rem, 12.4vw, 4rem);
    line-height: 0.98; /* más específico que .titulo: la pila va más apretada que un titular normal */
    letter-spacing: 0.004em;
    color: #fffdb4;
  }
  .stack-cap {
    margin: 0;
    max-width: 14rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: rgba(255, 253, 180, 0.75);
  }
  /* En móvil solo se muestra el subtítulo de la primera línea para no alargar el hero. */
  .stack-row:not(:first-child) .stack-cap {
    display: none;
  }

  /* La diana hace de «O» */
  .stack-word :global(.stack-o) {
    display: inline-block;
    width: 0.72em;
    height: 0.72em;
    margin: 0 0.02em;
    vertical-align: -0.015em;
    color: #78ab6b;
  }

  /* Cursor suave tras «Marketing»: solo pantallas amplias. */
  .stack-cursor {
    display: none;
  }
  .stack-cursor path {
    fill: #fffdb4;
    stroke: #351e28;
    stroke-width: 5;
    stroke-linejoin: round;
    stroke-linecap: round;
    paint-order: stroke fill;
  }

  @media (min-width: 768px) {
    .stack { gap: 0.1rem; }
    .stack-row {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }
    .stack-word { font-size: clamp(3.2rem, 7.6vw, 6.4rem); }
    .stack-cap,
    .stack-row:not(:first-child) .stack-cap {
      display: block;
      flex: none;
      width: 11rem;
      font-size: 0.8rem;
    }
    .stack-cap-left { text-align: right; }
  }
  @media (min-width: 1024px) {
    .stack-cursor {
      display: block;
      width: 0.62em;
      height: auto;
      margin-left: -0.2rem;
      font-size: clamp(3.2rem, 7.6vw, 6.4rem);
    }
  }

  /* Entrada de la diana (gira hasta asentarse) y del cursor, tras las palabras. */
  :global(html.hero-go) .stack-word :global(.stack-o) {
    animation: hero-o 700ms var(--ease-out) 600ms both;
  }
  @keyframes hero-o {
    from { opacity: 0; transform: rotate(-160deg) scale(0.6); }
  }
  :global(html.hero-go) .stack-cursor {
    animation:
      hero-cursor 500ms var(--ease-out) 800ms both,
      hero-click 260ms var(--ease-out) 1500ms;
    transform-origin: 4px 4px;
  }
  @keyframes hero-cursor {
    from { opacity: 0; transform: translate(-1.5rem, 1.2rem); }
  }
  @keyframes hero-click {
    50% { transform: scale(0.86); }
  }

  /* ---- Mapa ---- */
  .hero-map {
    width: min(100%, 20rem);
    flex: none;
  }
  @media (min-width: 768px) {
    .hero-map { width: clamp(240px, 24vw, 300px); }
  }

  /* ---- Pestaña vertical de contacto (solo escritorio) ---- */
  .hero-tab {
    display: none;
  }
  @media (min-width: 768px) {
    .hero-tab {
      position: absolute;
      right: 0;
      top: 50%;
      z-index: 5;
      display: block;
      padding: 1.5rem 0.75rem;
      background: #78ab6b;
      color: #351e28;
      font-size: 0.8rem;
      writing-mode: vertical-rl;
      transform: translateY(-50%) rotate(180deg);
      transition: background-color 150ms var(--ease-out);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-tab:hover { background: #fffdb4; }
  }
  .hero-tab:focus-visible {
    outline: 3px solid #fffdb4;
    outline-offset: -3px;
  }

  /* ---- Instagram ---- */
  .hero-ig {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    color: rgba(255, 253, 180, 0.7);
    transition: color 150ms var(--ease-out);
  }
  .hero-ig svg {
    stroke: currentColor;
    stroke-width: 1.8;
  }
  @media (min-width: 768px) {
    .hero-ig { right: 3rem; bottom: 2rem; }
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-ig:hover { color: #78ab6b; }
  }
  .hero-ig:focus-visible {
    outline: 2px solid #78ab6b;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.hero-go) .hero-in {
      animation-name: hero-fade;
      animation-duration: 200ms;
    }
    @keyframes hero-fade {
      from { opacity: 0; }
    }
    :global(html.hero-go) .stack-word :global(.stack-o),
    :global(html.hero-go) .stack-cursor { animation: none; }
  }
</style>
