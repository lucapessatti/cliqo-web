---
import Diana from "./Diana.astro";
import Logo from "./Logo.astro";
import PeakChart from "./PeakChart.astro";
import FlowButton from "./FlowButton.astro";
import { CTA_URL } from "../config";

// EJEMPLO con datos ficticios. No son datos reales de ningún negocio.
// `pct` = reseñas respecto al máximo del ejemplo (210), para las barras.
const competidores = [
  { nombre: "Competidor A", pos: "1.º", resenas: "210", nota: "4,6", pct: 100 },
  { nombre: "Competidor B", pos: "2.º", resenas: "143", nota: "4,5", pct: 68 },
  { nombre: "Competidor C", pos: "3.º", resenas: "92", nota: "4,4", pct: 44 },
];
const propiasPct = 18; // 38 de 210

const hallazgos = [
  {
    titulo: "Pocas reseñas y sin responder",
    detalle: "38 reseñas, 0 respondidas · Impacto: 8–15 clientes al mes",
  },
  {
    titulo: "Ficha sin horario de festivos",
    detalle: "Horario desactualizado · Impacto: 3–6 clientes al mes",
  },
  {
    titulo: "Sin botón de pedido o reserva",
    detalle: "Sin enlace directo · Impacto: 5–10 clientes al mes",
  },
];
---

<section id="ejemplo" data-section class="bg-crema text-aubergine">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <Diana clase="h-8 w-8 text-verde-oscuro" />

    <div data-reveal class="mt-7 flex flex-wrap items-end justify-between gap-4">
      <h2 class="titulo max-w-3xl text-[clamp(2rem,6vw,4rem)]">
        Así se ve un diagnóstico Cliqo.
      </h2>
      <span class="titulo rounded-md bg-aubergine px-3 py-2 text-[0.7rem] text-crema">
        Ejemplo con datos ficticios
      </span>
    </div>

    <!-- Resumen de una página (reconstruido) -->
    <!-- Capítulo 5: se ve de un vistazo. Las barras de reseñas crecen y las tres pérdidas entran una a una. -->
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,42rem)_minmax(0,28rem)] lg:items-start lg:gap-8">
    <div
      data-reveal
      data-story
      class="audit max-w-2xl rounded-2xl border-2 border-aubergine bg-crema p-6 sm:p-9"
    >
      <div class="flex items-center justify-between gap-3">
        <Logo tono="aubergine" clase="text-xl" />
        <span class="text-xs font-semibold text-texto-suave">Resumen de una página</span>
      </div>

      <h3 class="titulo mt-4 text-[clamp(1.75rem,7vw,3rem)] text-aubergine">
        Cafetería Ejemplo
      </h3>
      <p class="mt-2 text-sm text-texto-suave">
        Búsqueda: «cafetería cerca de mí»
      </p>

      <!-- Hallazgo principal -->
      <div class="mt-6 rounded-xl bg-aubergine p-5 text-crema">
        <p class="titulo text-xs text-verde">Lo que más os cuesta</p>
        <p class="mt-3 text-lg font-bold leading-snug sm:text-xl">
          De 4 cafeterías de la zona, sois la 4.ª en Google Maps: 38 reseñas
          frente a 210 de la primera.
        </p>
      </div>

      <!-- Tabla comparativa -->
      <h4 class="titulo mt-8 text-lg text-aubergine">Frente a los de al lado</h4>
      <table class="mt-4 w-full border-collapse text-left text-sm">
        <thead>
          <tr class="text-texto-suave">
            <th class="pb-2 font-semibold">Negocio</th>
            <th class="pb-2 text-right font-semibold">Pos.</th>
            <th class="pb-2 text-right font-semibold">Reseñas</th>
            <th class="pb-2 pl-2 text-right font-semibold">Nota</th>
          </tr>
        </thead>
        <tbody>
          <tr class="bg-verde font-bold text-aubergine">
            <td class="rounded-l-md py-2.5 pl-2">Cafetería Ejemplo</td>
            <td class="py-2.5 text-right">4.º</td>
            <td class="py-2.5 text-right">
              <span class="inline-flex items-center justify-end gap-2">
                <span class="track" aria-hidden="true">
                  <span class="bar bar-propia" style={`width: ${propiasPct}%`} />
                </span>
                <span>38</span>
              </span>
            </td>
            <td class="rounded-r-md py-2.5 pr-2 text-right">4,3</td>
          </tr>
          {
            competidores.map((c) => (
              <tr class="border-b border-aubergine/15 text-aubergine">
                <td class="py-2.5 pl-2">{c.nombre}</td>
                <td class="py-2.5 text-right">{c.pos}</td>
                <td class="py-2.5 text-right">
                  <span class="inline-flex items-center justify-end gap-2">
                    <span class="track" aria-hidden="true">
                      <span class="bar" style={`width: ${c.pct}%`} />
                    </span>
                    <span>{c.resenas}</span>
                  </span>
                </td>
                <td class="py-2.5 pr-2 text-right">{c.nota}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-3 text-xs text-texto-suave">
        Google Maps, en incógnito, desde 3 puntos cercanos al local.
      </p>

      <!-- Tres hallazgos -->
      <h4 class="titulo mt-8 text-lg text-aubergine">
        Tres cosas que os cuestan clientes
      </h4>
      <ul class="mt-4">
        {
          hallazgos.map((h, i) => (
            <li
              class="hallazgo flex gap-4 border-t border-aubergine/15 py-4"
              style={`--d: ${700 + i * 120}ms`}
            >
              <span class="titulo flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-aubergine text-sm text-crema">
                {i + 1}
              </span>
              <div>
                <p class="font-bold text-aubergine">{h.titulo}</p>
                <p class="mt-0.5 text-sm text-texto-suave">{h.detalle}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <!-- Cierre interno -->
      <div class="mt-8 rounded-xl bg-verde p-5 text-aubergine">
        <p class="titulo text-lg">¿Lo vemos en 15 minutos?</p>
        <p class="mt-1 font-semibold">Te explico cada punto y qué haría primero.</p>
        <p class="mt-3 text-sm font-semibold">Luca · Cliqo · luca@cliqo.es</p>
      </div>

      <p class="mt-5 text-xs text-texto-suave">
        Datos públicos de Google Maps e Instagram. El impacto es un rango
        estimado y depende de cómo se ejecute.
      </p>
    </div>

    <!-- Después del diagnóstico: línea base y seguimiento mensual (paso 4 del método). -->
    <div data-reveal style="--d: 150ms">
      <h3 class="titulo titulo-aire mb-4 text-xl sm:text-2xl">Y cada mes, lo medimos.</h3>
      <PeakChart />
      <p class="mt-4 max-w-md text-xs leading-relaxed text-texto-suave">
        Fijamos una línea base y comprobamos cada mes qué ha cambiado; no
        prometemos resultados.
      </p>
    </div>
    </div>

    <div class="mt-10">
      <FlowButton href={CTA_URL} text="¿Quieres ver el tuyo?" size="md" tone="claro" />
    </div>
  </div>
</section>

<style>
  /* Barras de reseñas dentro de la tabla (datos ficticios del ejemplo). */
  .track {
    display: inline-block;
    width: 2.5rem;
    height: 0.5rem;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(53, 30, 40, 0.14);
  }
  @media (min-width: 640px) {
    .track { width: 3.5rem; }
  }
  .bar {
    display: block;
    height: 100%;
    border-radius: 4px;
    background: #5b4650;
    transform-origin: left;
    transition: transform 700ms var(--ease-out) 450ms;
  }
  .bar-propia {
    background: #351e28;
  }
  :global(html.js) .audit:not(.in) .bar {
    transform: scaleX(0);
  }

  /* Las tres cosas que cuestan clientes entran una a una. */
  :global(html.js) .audit .hallazgo {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out);
    transition-delay: var(--d, 0ms);
  }
  :global(html.js) .audit.in .hallazgo {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar { transition-duration: 0ms; transition-delay: 0ms; }
    :global(html.js) .audit .hallazgo { transform: none; transition-duration: 200ms; }
  }
</style>
