---
import Diana from "./Diana.astro";
import Logo from "./Logo.astro";
import FlowButton from "./FlowButton.astro";
import { CTA_URL, INSTAGRAM_URL, LEMA, EMAIL } from "../config";
---

<section data-section class="relative isolate overflow-hidden bg-aubergine text-crema">
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-20 sm:px-8 sm:pb-20 sm:pt-28">
    <Diana clase="h-8 w-8 text-verde" />

    <h2 data-reveal class="titulo titulo-aire mt-7 max-w-3xl text-[clamp(2.25rem,7vw,5rem)] text-crema">
      ¿Miramos tu negocio?
    </h2>
    <p data-reveal style="--d: 80ms" class="mt-6 max-w-xl text-lg text-crema/85">
      Diagnóstico gratis de tu ficha de Google.
    </p>

    <!-- Capítulo final: la diana se cierra sobre el botón y llega el clic. Es tu clic. -->
    <div class="cta-wrap relative mt-9 inline-block" data-story>
      <svg class="rings" viewBox="0 0 600 600" fill="none" aria-hidden="true">
        <circle class="rg g1" cx="300" cy="300" r="290" />
        <circle class="rg g2" cx="300" cy="300" r="290" />
        <circle class="rg g3" cx="300" cy="300" r="290" />
      </svg>

      <FlowButton id="cta-cierre" class="cta" href={CTA_URL} text="Escríbenos «Diagnóstico»" size="lg" tone="oscuro" />

      <span class="ripple" aria-hidden="true"></span>
      <span class="cursor" aria-hidden="true">
        <svg viewBox="-2 -2 32 48" width="32" height="48">
          <path d="M0 0 L0 38 L9.5 29.5 L16 44 L22.5 41 L16 26.5 L28 26.5 Z" />
        </svg>
      </span>
    </div>
  </div>

  <footer class="border-t border-crema/15">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 pb-28 sm:flex-row sm:items-center sm:justify-between sm:px-8 sm:pb-10"
    >
      <div class="flex flex-col gap-1">
        <Logo tono="crema" clase="text-xl" />
        <span class="text-sm text-crema/60">{LEMA}</span>
      </div>

      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-crema/70">
        <a href={`mailto:${EMAIL}`} class="hover:text-verde">{EMAIL}</a>
        {INSTAGRAM_URL && (
          <a href={INSTAGRAM_URL} class="hover:text-verde">Instagram</a>
        )}
        <a href="/aviso-legal" class="hover:text-verde">Aviso legal</a>
        <a href="/privacidad" class="hover:text-verde">Política de privacidad</a>
      </nav>
    </div>
  </footer>
</section>

<style>
  /* Anillos alrededor del botón: bullseye. Se cierran sobre él al llegar. */
  .rings {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 600px;
    height: 600px;
    margin: -300px 0 0 -300px;
    z-index: -10;
    pointer-events: none;
  }
  /* Ondas que salen del botón tras el clic y se desvanecen: no dejan líneas sobre el texto. */
  .rg {
    stroke: #78ab6b;
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .cta-wrap.in .g1 { animation: ring-out 1300ms var(--ease-out) 1440ms forwards; }
  .cta-wrap.in .g2 { animation: ring-out 1300ms var(--ease-out) 1640ms forwards; }
  .cta-wrap.in .g3 { animation: ring-out 1300ms var(--ease-out) 1840ms forwards; }
  @keyframes ring-out {
    from { opacity: 0.45; transform: scale(0.1); }
    to { opacity: 0; transform: scale(1); }
  }

  /* Cursor: llega, y su punta cae sobre el botón. */
  .cursor {
    position: absolute;
    left: 92%;
    top: 46%;
    z-index: 2;
    pointer-events: none;
    transition:
      transform 520ms var(--ease-out) 800ms,
      opacity 200ms ease 800ms;
  }
  .cursor path {
    fill: #fffdb4;
    stroke: #351e28;
    stroke-width: 2.4;
    stroke-linejoin: miter;
    stroke-miterlimit: 10;
  }
  :global(html.js) .cta-wrap:not(.in) .cursor {
    opacity: 0;
    transform: translate(80px, -60px);
  }
  /* Sin JS no hay historia: el cursor no se muestra. */
  :global(html:not(.js)) .cursor { display: none; }

  /* El botón «cede» al clic y suelta una onda. */
  .cta-wrap.in :global(.cta) {
    animation: cta-press 260ms var(--ease-out) 1380ms;
  }
  @keyframes cta-press {
    50% { transform: scale(0.96); }
  }
  .ripple {
    position: absolute;
    inset: 0;
    border: 2px solid #78ab6b;
    border-radius: 9999px;
    opacity: 0;
    pointer-events: none;
  }
  .cta-wrap.in .ripple {
    animation: btn-ripple 800ms var(--ease-out) 1440ms forwards;
  }
  @keyframes btn-ripple {
    from { opacity: 0.9; transform: scale(1); }
    to { opacity: 0; transform: scale(1.3, 1.7); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rings, .cursor, .ripple { display: none; }
    .cta-wrap.in :global(.cta) { animation: none; }
  }
</style>
