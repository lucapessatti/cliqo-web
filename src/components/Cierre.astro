---
import Asterisco from "./Asterisco.astro";
import Logo from "./Logo.astro";
import { WHATSAPP_URL, INSTAGRAM_URL, UBICACION } from "../config";
---

<section class="bg-aubergine text-crema">
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-20 sm:px-8 sm:pb-20 sm:pt-28">
    <Asterisco clase="h-8 w-8 text-verde" />

    <h2 class="titulo mt-7 max-w-3xl text-[clamp(2.25rem,7vw,5rem)] text-crema">
      ¿Miramos tu negocio?
    </h2>
    <p class="mt-6 max-w-xl text-lg text-crema/85">
      Mini-auditoría gratis de tu ficha de Google.
    </p>

    <a
      href={WHATSAPP_URL}
      class="titulo mt-9 inline-block rounded-lg bg-verde px-8 py-5 text-base text-aubergine transition-transform hover:scale-[1.03]"
    >
      Escríbenos «Auditoría»
    </a>
  </div>

  <footer class="border-t border-crema/15">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 pb-28 sm:flex-row sm:items-center sm:justify-between sm:px-8 sm:pb-10"
    >
      <div class="flex flex-col gap-1">
        <Logo tono="crema" clase="text-xl" />
        <span class="text-sm text-crema/60">{UBICACION}</span>
      </div>

      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-crema/70">
        <a href={INSTAGRAM_URL} class="hover:text-verde">Instagram</a>
        <a href="/aviso-legal" class="hover:text-verde">Aviso legal</a>
        <a href="/privacidad" class="hover:text-verde">Política de privacidad</a>
      </nav>
    </div>
  </footer>
</section>
