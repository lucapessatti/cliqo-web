---
import Asterisco from "./Asterisco.astro";
import { SHOW_PRICES } from "../config";

const servicios = [
  {
    nombre: "Mini-auditoría",
    gratis: true,
    texto: "Una revisión de tu ficha de Google con lo que vemos desde fuera.",
  },
  {
    nombre: "Auditoría completa",
    gratis: false,
    texto: "Análisis de tu ficha, redes y números, con devolución y plan de acción.",
  },
  {
    nombre: "Acompañamiento mensual",
    gratis: false,
    texto: "Seguimiento, medición y mejoras continuas.",
  },
];
---

<section class="bg-verde text-aubergine">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <Asterisco clase="h-8 w-8 text-aubergine" />

    <h2 class="titulo mt-7 max-w-3xl text-[clamp(2rem,6vw,4rem)]">
      Por dónde empezar.
    </h2>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {
        servicios.map((s) => (
          <div class="flex flex-col rounded-xl bg-aubergine p-7 text-crema">
            <div class="flex items-center gap-3">
              <h3 class="titulo text-xl">{s.nombre}</h3>
              {s.gratis && (
                <span class="titulo rounded bg-verde px-2 py-1 text-[0.65rem] text-aubergine">
                  Gratis
                </span>
              )}
            </div>
            <p class="mt-3 flex-1 leading-relaxed text-crema/80">{s.texto}</p>
            {SHOW_PRICES && (
              <p class="titulo mt-5 text-lg text-verde">TODO: precio</p>
            )}
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-lg font-semibold">
      Precio tras una llamada de 15 minutos.
    </p>
  </div>
</section>
