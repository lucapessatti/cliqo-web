---
import Diana from "./Diana.astro";
import { SHOW_PRICES } from "../config";

const servicios = [
  {
    nombre: "Diagnóstico",
    gratis: true,
    texto: "Una revisión de tu ficha de Google con lo que vemos desde fuera.",
  },
  {
    nombre: "Proyecto puntual",
    gratis: false,
    texto: "Datos, marketing digital o procesos: una mejora concreta, con objetivo y plazo.",
  },
  {
    nombre: "Acompañamiento mensual",
    gratis: false,
    texto: "Seguimiento, medición y mejoras continuas.",
  },
];

// Escalera: cada paso sube un peldaño (solo en pantallas anchas).
const peldanos = ["md:mt-16", "md:mt-8", "md:mt-0"];
---

<section data-section class="bg-verde text-aubergine">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <Diana clase="h-8 w-8 text-aubergine" />

    <h2 data-reveal class="titulo mt-7 max-w-3xl text-[clamp(2rem,6vw,4rem)]">
      Por dónde empezar.
    </h2>

    <!-- Capítulo 6: por dónde empezar, como una escalera que sube. -->
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {
        servicios.map((s, i) => (
          <div
            data-reveal
            class={`flex flex-col rounded-xl bg-aubergine p-7 text-crema ${peldanos[i]}`}
            style={`--d: ${i * 130}ms`}
          >
            <div class="flex items-center gap-3">
              <h3 class="titulo text-xl">{s.nombre}</h3>
              {s.gratis && (
                <span class="titulo rounded bg-verde px-2 py-1 text-[0.65rem] text-aubergine">
                  Gratis
                </span>
              )}
            </div>
            <p class="mt-3 flex-1 leading-relaxed text-crema/80">{s.texto}</p>
            {SHOW_PRICES && (
              <p class="titulo mt-5 text-lg text-verde">TODO: precio</p>
            )}
          </div>
        ))
      }
    </div>

    <p data-reveal style="--d: 300ms" class="mt-10 text-lg font-semibold">
      Precio tras una llamada de 15 minutos.
    </p>
  </div>
</section>
