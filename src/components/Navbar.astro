---
import Logo from "./Logo.astro";
import { WHATSAPP_URL } from "../config";

const enlaces = [
  { texto: "Qué hacemos", href: "#que-hacemos" },
  { texto: "Cómo trabajamos", href: "#como-trabajamos" },
  { texto: "Ejemplo", href: "#ejemplo" },
];
---

<header class="bg-aubergine">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-5 sm:px-8">
    <a href="#inicio" class="shrink-0">
      <Logo tono="crema" clase="text-2xl" />
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            class="text-sm font-semibold text-crema/80 underline-offset-4 transition-colors hover:text-verde hover:underline"
          >
            {e.texto}
          </a>
        ))
      }
    </div>

    <a
      href={WHATSAPP_URL}
      class="titulo hidden rounded-lg bg-verde px-5 py-3 text-xs text-aubergine transition-transform hover:scale-[1.03] sm:inline-block"
    >
      Pedir mini-auditoría
    </a>
  </nav>
</header>
