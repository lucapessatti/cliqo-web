---
import Asterisco from "./Asterisco.astro";

const pasos = [
  {
    titulo: "Llamada",
    texto: "15 minutos: escuchamos tu negocio y qué te preocupa.",
  },
  {
    titulo: "Auditoría",
    texto: "Revisamos tu ficha de Google, tus redes y tus números.",
  },
  {
    titulo: "Devolución",
    texto: "Te contamos qué hemos encontrado y qué haríamos primero (máximo 3 acciones).",
  },
  {
    titulo: "Seguimiento mensual",
    texto: "Medimos si algo ha cambiado.",
  },
];
---

<section id="como-trabajamos" class="bg-aubergine text-crema">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <Asterisco clase="h-8 w-8 text-verde" />

    <h2 class="titulo mt-7 max-w-3xl text-[clamp(2rem,6vw,4rem)] text-crema">
      Así trabajamos, en 4 pasos.
    </h2>

    <ol class="mt-12 max-w-3xl">
      {
        pasos.map((p, i) => (
          <li class="flex gap-5 border-t border-crema/15 py-6">
            <span class="titulo shrink-0 text-3xl text-verde">{i + 1}</span>
            <div>
              <h3 class="titulo text-xl text-crema">{p.titulo}</h3>
              <p class="mt-2 max-w-xl leading-relaxed text-crema/80">{p.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="mt-10 max-w-xl text-lg font-semibold text-verde">
      Sin letra pequeña: primero miramos, luego decides.
    </p>
  </div>
</section>
